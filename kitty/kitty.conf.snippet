# Requires kitty >= 0.49.0 (custom_shaders feature) — install kitty-git from the AUR
# to get this today, since 0.48.2 stable does not have it yet.
# Copy the *.slang and *.pipeline files from shaders/ into ~/.config/kitty/shaders/,
# then enable exactly one of the pipelines below in kitty.conf:

cursor_trail 1

# Minty green/blue parallelogram trail
# custom_shaders ghostty-slasher

# Neon pink -> blue -> teal gradient parallelogram trail
custom_shaders perfection

# Hexagonal trail using kitty's actual cursor color
# custom_shaders cursor

# Procedural ember/spark burst (original effect, not a Ghostty port)
# custom_shaders cursor-trail-spark
